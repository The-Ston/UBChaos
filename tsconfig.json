{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // The Worker imports the Data Dragon helpers from the client module.
    "allowJs": true
  },
  "include": ["src", "worker-configuration.d.ts"]
}
